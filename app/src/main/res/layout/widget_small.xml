<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center_vertical" android:background="@drawable/widget_bg"
    android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="1dp" android:paddingBottom="2dp">
    <TextView android:id="@+id/exam_d_day"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="end|center_vertical" android:singleLine="true"
        android:includeFontPadding="false" android:textSize="7sp"
        android:textColor="#FFB6DC" android:text="수능 D-356"/>
    <TextView android:id="@+id/room_row_1" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:singleLine="true" android:ellipsize="end"
        android:includeFontPadding="false" android:textSize="9sp"
        android:textColor="#FFFFFF" android:text="1번 톡방"/>
    <TextView android:id="@+id/room_row_2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:singleLine="true" android:ellipsize="end"
        android:includeFontPadding="false" android:textSize="9sp"
        android:textColor="#FFFFFF" android:text="2번 톡방"/>
    <TextView android:id="@+id/room_row_3" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:singleLine="true" android:ellipsize="end"
        android:includeFontPadding="false" android:textSize="9sp"
        android:textColor="#FFFFFF" android:text="3번 톡방"/>
    <TextView android:id="@+id/room_row_4" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:gravity="center_vertical"
        android:singleLine="true" android:ellipsize="end"
        android:includeFontPadding="false" android:textSize="9sp"
        android:textColor="#FFFFFF" android:text="4번 톡방"/>
</LinearLayout>