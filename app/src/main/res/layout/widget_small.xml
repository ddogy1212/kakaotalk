<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <!-- Position all rows as ONE centered group. Each row must use the same
         horizontal center, with no special row-only right padding. -->
    <LinearLayout
        android:id="@+id/widget_chat_positioner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">
        <LinearLayout
            android:id="@+id/widget_chat_rows"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/room_row_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:text="1번 톡방"/>

            <TextView
                android:id="@+id/room_row_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:text="2번 톡방"/>

            <TextView
                android:id="@+id/room_row_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:text="3번 톡방"/>

            <TextView
                android:id="@+id/room_row_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textSize="9sp"
                android:textColor="#FFFFFF"
                android:text="4번 톡방"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Padding is updated from user sliders by RemoteViews.
         The separate overlay never changes the centered chat layout. -->
    <FrameLayout
        android:id="@+id/exam_day_anchor"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="9dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/exam_d_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:gravity="end|top"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textSize="5sp"
            android:textColor="#FFB6DC"
            android:text="수능 D-day"/>
    </FrameLayout>
</FrameLayout>
